# ViralTrack configuration. Copy to .env and fill in. Never commit .env.
#
# The YouTube foundation (upstream/youtube-niche-finder) has its own settings:
# copy upstream/youtube-niche-finder/.env.example to that folder's .env and put
# YOUTUBE_API_KEY there. ViralTrack itself never calls the YouTube API.

# --- environment / logging --------------------------------------------------
# development | test | production
VT_ENV=development
# DEBUG | INFO | WARNING | ERROR
VT_LOG_LEVEL=INFO

# --- YouTube provider (talks to the niche-finder HTTP API) ------------------
VT_YOUTUBE_ENABLED=true
VT_YOUTUBE_FOUNDATION_URL=http://localhost:8080
# Only when niche-finder runs with NF_MULTI_USER=1: a personal API token.
VT_YOUTUBE_FOUNDATION_TOKEN=
VT_YOUTUBE_TIMEOUT_SECONDS=20
# What the foundation's database holds: real | demo (niche-finder seed_demo) | test.
# Must be real in production. Records carry it as their DataOrigin.
VT_YOUTUBE_DATA_ORIGIN=real

# --- ingestion (on-demand collection through the foundation; spends quota) --
# Off by default. While false, collect/refresh/status calls raise
# IngestionDisabled and send nothing. Internal use only.
VT_YOUTUBE_INGESTION_ENABLED=false
# search.list pages per keyword collection (1-5).
VT_YOUTUBE_MAX_SEARCH_PAGES=1
# Videos per creator collection or refresh (1-500).
VT_YOUTUBE_MAX_VIDEOS_PER_COLLECT=200
# Refuse on-demand collection when the foundation reports fewer units left today...
VT_YOUTUBE_QUOTA_FLOOR_UNITS=1000
# ...or fewer search calls left than the pages asked for plus this reserve.
VT_YOUTUBE_QUOTA_FLOOR_SEARCH_CALLS=10

# --- database (the niche-finder Postgres, used by the retention job) --------
# docs/architecture/DATABASE_CONFIGURATION.md and
# docs/deployment/DATABASE_PROVIDER_COMPATIBILITY.md explain every value.
# DATABASE_URL is a secret: never commit a real one. Placeholders only below.
#
# Provider profile: local | neon | supabase | aiven | postgres (any other PostgreSQL).
DATABASE_PROVIDER=local
# Empty = under docker compose, the retention service uses the compose `postgres`
# service. Set it only to run ViralTrack outside Docker or against a managed database.
DATABASE_URL=
DATABASE_SCHEMA=public
# Empty = the profile's default (local/postgres: libpq default; neon/supabase/aiven: require).
# Managed profiles refuse anything weaker than require.
DATABASE_SSL_MODE=
# Pool limits for any long-running ViralTrack process. The retention job opens one connection.
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10
# Milliseconds per statement (SET LOCAL, so it works through poolers); 0 = no limit.
DATABASE_STATEMENT_TIMEOUT=600000
DATABASE_APPLICATION_NAME=viraltrack
#
# Examples (copy one block, replace every <placeholder>; take the string from the
# provider's dashboard, never compose hosts by hand):
#
# Local Docker, running ViralTrack on the host (upstream publishes Postgres on 127.0.0.1:5433):
#   DATABASE_PROVIDER=local
#   DATABASE_URL=postgresql://<user>:<password>@localhost:5433/<database>
#
# Neon (Console > project > Connect). Direct host = ep-<id>.<region>.aws.neon.tech;
# pooled host adds -pooler (PgBouncer, transaction mode). Either works for retention;
# the foundation needs the DIRECT one.
#   DATABASE_PROVIDER=neon
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint-host>/<database>?sslmode=verify-full
#
# Supabase (project > Connect). Direct: db.<project-ref>.supabase.co:5432 (IPv6 unless the
# IPv4 add-on). Shared pooler: <pooler-host>:5432 = session mode, :6543 = transaction mode,
# user postgres.<project-ref>. The foundation needs direct or session mode.
#   DATABASE_PROVIDER=supabase
#   DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/postgres?sslmode=require
#
# Aiven (service > Overview > Connection information, "Service URI"; download the CA
# certificate there for verify-ca / verify-full).
#   DATABASE_PROVIDER=aiven
#   DATABASE_URL=postgresql://<user>:<password>@<service-host>:<port>/<database>?sslmode=verify-full&sslrootcert=<path-to-ca.pem>
#
# Any other PostgreSQL 16 with pgvector (production requires sslmode require or stronger):
#   DATABASE_PROVIDER=postgres
#   DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
#   DATABASE_SSL_MODE=verify-full
#
# The FOUNDATION (niche-finder web/worker/mcp) has its own connection settings and never
# reads DATABASE_URL: POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER,
# POSTGRES_PASSWORD (interpolated into its compose file) and, for TLS, PGSSLMODE through
# deploy/compose.managed-db.yml. See docs/architecture/DATABASE_CONFIGURATION.md.

# --- retention (YouTube API Services Developer Policies III.E.4) ------------
# Set to true ONLY after Google has accepted this project's "Analytics &
# Reporting" derived-metrics amendment. It allows statistics up to 1095 days
# and unlocks RESTRICTED derived metrics (docs/phase-1/DERIVED_METRIC_POLICY.md).
VT_YOUTUBE_ANALYTICS_AMENDMENT_ACCEPTED=false
# Statistics window: max 30 without the amendment, max 1095 with it.
VT_RETENTION_YOUTUBE_STATS_DAYS=30
# Titles, descriptions, names, thumbnails: max 30 in every case.
VT_RETENTION_YOUTUBE_TEXT_DAYS=30
# false = report only. The docker-compose retention service passes --apply.
VT_RETENTION_APPLY=false
# Transcript storage is not approved (legal/platform review pending): while
# false, every retention run deletes all stored transcripts.
VT_TRANSCRIPTS_APPROVED=false
