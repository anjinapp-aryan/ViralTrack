      "MetricValue": {
        "additionalProperties": false,
        "description": "One number from outside ViralTrack, with where it came from.",
        "properties": {
          "collected_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "when the value was read from the platform; null when the provider does not report it",
            "title": "Collected At"
          },
          "foundation_first_seen_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "when the foundation first stored the item; not the read time of this value",
            "title": "Foundation First Seen At"
          },
          "kind": {
            "description": "raw: returned by the platform; derived: calculated",
            "enum": [
              "raw",
              "derived"
            ],
            "title": "Kind",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "formula or caveat; set for derived values",
            "title": "Note"
          },
          "origin": {
            "description": "real provider data, or synthetic demo or test data",
            "enum": [
              "real_provider_data",
              "demo",
              "test"
            ],
            "title": "Origin",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "source": {
            "description": "who produced the value, e.g. youtube-data-api",
            "title": "Source",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "value",
          "kind",
          "source",
          "provider",
          "origin",
          "collected_at",
          "foundation_first_seen_at",
          "note"
        ],
        "title": "MetricValue",
        "type": "object"
      },
