  "info": {
    "description": "Platform-neutral discovery over provider data. Only metrics the ViralTrack metric policy allows are part of this contract; unknown values are null.",
    "title": "ViralTrack API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/capabilities": {
      "get": {
        "operationId": "capabilities_api_v1_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Platforms, filters, sorts and metrics this deployment supports.",
        "tags": [
          "capabilities"
        ]
      }
    },
    "/api/v1/creators": {
      "get": {
        "operationId": "creators_api_v1_creators_get",
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "required": false,
            "schema": {
              "default": "30d",
              "pattern": "^(all|[1-9][0-9]{0,3}[hd])$",
              "title": "Period",
              "type": "string"
            }
          },
          {
            "in": "query",
